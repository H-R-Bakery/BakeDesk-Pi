# BakeDesk-Pi production environment. Copy to .env and replace local secrets.
COMPOSE_PROJECT_NAME=bakedesk
BAKEDESK_IMAGE_TAG=local

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-long-random-secret
DEFAULT_URI=http://bakedesk.local

BAKERY_TIMEZONE=America/Indiana/Indianapolis
BAKERY_BRAND_NAME="H&R Bakery"
BAKEDESK_BRAND_NAME=BakeDesk
BAKERY_LOGO_ASSET=Images/HRBakeryLogo.svg
BAKERY_PRINT_LOGO_PATH=assets/Images/HRBakeryLogo_bw.svg
APP_SHARE_DIR=var/share

POSTGRES_VERSION=18
POSTGRES_DB=bakery
POSTGRES_USER=baker
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL="postgresql://baker:replace-with-a-long-random-password@database:5432/bakery?serverVersion=18&charset=utf8"

# Symfony Redis Messenger uses Valkey's Redis-compatible protocol.
MESSENGER_TRANSPORT_DSN=redis://valkey:6379/messages

GOTENBERG_BASE_URL=http://gotenberg:8833

MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://bakedesk.local/.well-known/mercure
MERCURE_JWT_SECRET=replace-with-a-long-random-mercure-secret
